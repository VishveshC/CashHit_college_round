  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "wagmi": "3.7.7",
    "viem": "2.57.4",
    "@tanstack/react-query": "5.104.1",
    "siwe": "3.0.0",
    "zod": "4.6.5",
    "@prisma/client": "6.12.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "prisma": "6.12.0"
  }
}
